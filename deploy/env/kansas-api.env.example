# Production env for future-wells-ks-api.service. Copy alongside .env on
# the deploy host and fill in real values; never commit the filled-in copy.

DATABASE_URL=postgresql://future_wells_kansas_user:changeme@localhost:5432/future_wells_kansas
KS_API_HOST=127.0.0.1
KS_API_PORT=4008
KS_SOURCE_ARCHIVE_ROOT=/home/yaro/projects/kansasBackend/data/kansas
KS_LOG_LEVEL=info

