# Kansas backend — environment example. Copy to .env and fill in real
# values locally; never commit .env. No credentials below are real.

# Required. Local dev convention uses `future_wells_kansas` as the example
# database name only — this file, not source code, is where that name lives.
DATABASE_URL=postgresql://future_wells_kansas_user:changeme@localhost:5432/future_wells_kansas

# Optional. API bind address/port for future_wells_ks_api.
KS_API_HOST=0.0.0.0
KS_API_PORT=4008

# Optional. Local filesystem root for archived source downloads, once the
# source/ ingestion layer lands (KS-004+). Defaults to ./data/kansas.
KS_SOURCE_ARCHIVE_ROOT=./data/kansas

# Optional. tracing-subscriber EnvFilter string. Defaults to "info".
KS_LOG_LEVEL=info

# --- Official KGS/KCC source URLs (KS-002 seed) ---
# All optional — code falls back to the confirmed values below. Override
# only if an agency moves a URL; see src/config.rs::SourceUrls and
# `ks_ingest sources` / `ks_ingest resolve-arcgis`.

KGS_WELLS_CATALOG=https://www.kgs.ku.edu/PRS/petroDB.html
# Stable ArcGIS Online item ID — resolved to its current service URL at
# runtime by `ks_ingest resolve-arcgis` (src/source/arcgis.rs).
KGS_WELLS_ARCGIS_ITEM_ID=514428df866b46c893b6834ff0bf303d
# Pinned fallback layer URL, used only when runtime resolution fails.
KGS_WELLS_ARCGIS_LAYER=https://services2.arcgis.com/ZOdjAzAQ2B0f85zi/ArcGIS/rest/services/Oil_and_Gas_Wells_Download/FeatureServer/0
KGS_WELLS_STATIC_ZIP=https://www.kgs.ku.edu/PRS/Ora_Archive/ks_wells.zip
KGS_WELLS_FORMAT=https://www.kgs.ku.edu/PRS/file_format.html

KGS_LEASES_CATALOG=https://www.kgs.ku.edu/Magellan/Field/lease.html
KGS_ALL_LEASES_ZIP=https://www.kgs.ku.edu/PRS/Ora_Archive/all_kansas_leases.zip
KGS_LEASE_FORMAT=https://www.kgs.ku.edu/Magellan/Field/lease_file_format.html

# Base URL; joined with the 8 fixed filenames in constants::KGS_PRODUCTION_FILES
# (oil/gas leases x 2020-present/2010-2019/2000-2009/1990-1999).
KGS_PRODUCTION_ARCHIVE_BASE=https://www.kgs.ku.edu/PRS/Ora_Archive/

KGS_FIELDS_CATALOG=https://www.kgs.ku.edu/Magellan/Field/index.html
# Confirmed live 2026-09-05 (KS-08).
KGS_FIELDS_ARCGIS_ITEM_ID=390ee1b9eade40bca42ee3534a813b20
KGS_FIELDS_ARCGIS_LAYER=https://services2.arcgis.com/ZOdjAzAQ2B0f85zi/arcgis/rest/services/Oil_and_Gas_Fields/FeatureServer/0
# Base URL; joined with constants::KGS_FIELD_ACTIVE_FILES (6 fixed .xlsx filenames).
KGS_FIELD_FILES_BASE=https://www.kgs.ku.edu/Magellan/Field/
KGS_FIELD_ABANDONED_FILE=https://www.kgs.ku.edu/Magellan/Field/fields_abandoned.xlsx
KGS_HORIZONTAL_WELLS=https://chasm.kgs.ku.edu/ords/qualified.ogw5.HorizWells

KCC_DATA_SEARCH=https://www.kcc.ks.gov/oil-gas/data-search
KCC_INTENTS=https://www.kcc.ks.gov/notices-of-intents-search
KCC_OPERATORS=https://www.kcc.ks.gov/kansas-oil-operators
KCC_TRANSFERS=https://www.kcc.ks.gov/notices-of-transfers-approved-search
KCC_TRANSFER_RESULTS=https://www.kcc.ks.gov/transfersSearch.php
KCC_FORMS=https://www.kcc.ks.gov/oil-gas/oil-gas-forms
KCC_CONSERVATION_DOCKETS=https://www.kcc.ks.gov/oil-gas/conservation-dockets
KCC_CONNECT=https://kcc-connect.kcc.ks.gov/
